{
  "name": "planeta-skin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-pages.mjs && node scripts/build-shop-catalog.mjs --check && node scripts/build-sitemap.mjs",
    "check": "node scripts/check-pages.mjs && node scripts/build-shop-catalog.mjs --check",
    "shop:catalog:check": "node scripts/build-shop-catalog.mjs --check",
    "build": "vite build && node scripts/critical.mjs",
    "build:fast": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/build-icons-sprite.mjs",
    "critical": "node scripts/critical.mjs",
    "sitemap": "node scripts/build-sitemap.mjs",
    "social-meta": "node scripts/inject-social-meta.mjs",
    "lazy-images": "node scripts/inject-lazy-images.mjs",
    "images:compress": "node scripts/compress-images.mjs",
    "images:dimensions": "node scripts/inject-image-dimensions.mjs",
    "images:picture": "node scripts/inject-picture-tags.mjs",
    "shop:catalog": "node scripts/build-shop-catalog.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "critters": "^0.0.23",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "vite": "npm:rolldown-vite@7.2.2"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.2"
  }
}
