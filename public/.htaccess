RewriteEngine On
RewriteBase /

# Собственная страница 404 (dist/404.html заливается в корень домена).
# Без этой строки Apache отдаёт свою дефолтную страницу ошибки.
ErrorDocument 404 /404.html

# === Принудительный HTTPS ===
# На reg.ru SSL-сертификат работает, HTTP-клиентов редиректим.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# === Канонизация URL ===

# 1. Убираем index.html из любых URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*/)?index\.html[\ ?] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

# 2. Редирект /page.html -> /page/ (на случай старых ссылок/закладок)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html[\ ?] [NC]
RewriteRule ^([^.]+)\.html$ /$1/ [R=301,L]

# 3. Добавляем завершающий слэш к "папочным" URL
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/ -d
RewriteRule ^(.*)$ /$1/ [R=301,L]

# === Заголовки безопасности ===
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

  # HSTS: включаем HTTPS-first на год. Важно: включаем только ПОСЛЕ того, как
  # убедились, что сайт полноценно работает на HTTPS — откатить можно только
  # через те же 12 месяцев, так как браузеры кешируют заголовок.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content-Security-Policy: разрешаем только собственные ресурсы + аналитику
  # (Яндекс.Метрика, Top.Mail.Ru) + карту яндекса в iframe. 'unsafe-inline' нужен
  # Яндекс.Метрике (она инжектит инлайн-скрипты) и inline-стилям в HTML.
  # worker-src нужен SmartCaptcha: SDK подгружает shield-чанк как Web Worker
  # (часть через прямой URL, часть через Blob). Без явного worker-src браузер
  # откатывается на default-src 'self' и режет проверку — форма отдаёт пустой
  # токен и бэк возвращает 422 «капча не пройдена».
  Header set Content-Security-Policy "default-src 'self'; \
    script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://top-fwz1.mail.ru https://yandex.ru https://smartcaptcha.yandexcloud.net; \
    worker-src 'self' blob: https://smartcaptcha.yandexcloud.net; \
    style-src 'self' 'unsafe-inline'; \
    img-src 'self' data: https: blob:; \
    font-src 'self' data:; \
    connect-src 'self' https://mc.yandex.ru https://top-fwz1.mail.ru https://smartcaptcha.yandexcloud.net; \
    frame-src 'self' https://mc.yandex.ru https://yandex.ru https://yandex.com https://smartcaptcha.yandexcloud.net; \
    media-src 'self'; \
    object-src 'none'; \
    base-uri 'self'; \
    form-action 'self'; \
    frame-ancestors 'self'; \
    upgrade-insecure-requests"

  # Долгоживущее кеширование для неизменных ассетов (hash в имени файла)
  <FilesMatch "\.(?:js|css|woff2|woff|svg|png|jpg|jpeg|webp|avif|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — не кешируем агрессивно (пусть SW/браузер перепроверяют)
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # sw.js — исключение из правила для *.js выше: service worker должен
  # обновляться сразу, иначе браузеры вправе держать старую версию до суток
  # (эта секция ниже общей для .js, поэтому её Header set побеждает).
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # sitemap.xml и robots.txt — короткое кеширование для быстрой раскатки изменений
  <FilesMatch "(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# === Кеширование sw.js ===
# ФАКТ ПРО REG.RU: статику (.js/.css/картинки) раздаёт фронтовый nginx НАПРЯМУЮ,
# мимо Apache — поэтому Header set/mod_expires из этого файла на неё не влияют,
# и sw.js уходит с nginx'овским "Cache-Control: max-age=3888000" (45 дней).
# Это приемлемо: современные браузеры при проверке обновлений service worker
# игнорируют HTTP-кеш (спецификация в худшем случае ограничивает его сутками),
# так что баннер «Доступна новая версия» работает. Блок ниже оставлен на случай,
# если статика когда-нибудь пойдёт через Apache (смена тарифа/хостинга).
<IfModule mod_expires.c>
  <Files "sw.js">
    ExpiresActive Off
  </Files>
</IfModule>

# === Персональные данные ===
# Основная защита — физический вынос каталога за пределы вебрута (см.
# data_dir() в send-form/index.php). Правила ниже — второй рубеж на случай,
# если PHP откатился на легаси-путь /data/ внутри вебрута.
# ВНИМАНИЕ: на reg.ru статику раздаёт nginx мимо Apache, поэтому на эти
# директивы полагаться нельзя — они лишь дублируют основную защиту.
RedirectMatch 404 ^/data(/|$)

<FilesMatch "\.jsonl$">
  Require all denied
</FilesMatch>

# === Служебные файлы Cloudflare Pages (_headers, _redirects) ===
# Они попадают в корень при сборке, но на Apache/reg.ru бесполезны.
# Запрещаем их публичный просмотр, чтобы не светить конфиг.
<FilesMatch "^_(headers|redirects|routes)$">
  Require all denied
</FilesMatch>

# === GZIP ===
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
