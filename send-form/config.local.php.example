<?php
/**
 * Локальная конфигурация (SMTP + капча). Скопируйте файл в config.local.php
 * и заполните своими креденшалами. config.local.php в .gitignore — в
 * репозиторий не попадает.
 *
 * Если файла нет или поля пустые:
 *   - SMTP: index.php автоматически использует mail();
 *   - капча: на локалке и превью проверка просто отключается, а на боевых
 *     хостах форма ОТКАЗЫВАЕТСЯ принимать заявки (fail-closed) — то есть
 *     без этого файла прод не работает. Это сделано намеренно: раньше потеря
 *     конфига молча открывала формы ботам.
 *   - каталог с ПД: создаётся автоматически вне вебрута (см. data_dir).
 */

return [
    /**
     * Каталог для логов с персональными данными (leads.jsonl, drops.jsonl,
     * ratelimit/). Абсолютный путь, ОБЯЗАТЕЛЬНО вне вебрута.
     *
     * Если не задан, index.php сам создаст <родитель вебрута>/planeta-data —
     * на reg.ru это обычно то, что нужно. Задавайте явно, только если структура
     * каталогов на хостинге отличается или PHP не может писать на уровень выше.
     *
     * Проверить, что защита работает:
     *   curl -I https://hs-planet.ru/data/leads.jsonl   → должно быть 404
     */
    // 'data_dir' => '/var/www/uXXXXXXX/data/planeta-data',

    'smtp' => [
        'enabled'  => false,                  // переключатель: true → отправляем через SMTP
        'host'     => 'smtp.reg.ru',          // у reg.ru обычно smtp.reg.ru или mail.hosting.reg.ru
        'port'     => 465,                    // 465 (SSL) или 587 (TLS)
        'secure'   => 'ssl',                  // 'ssl' для 465, 'tls' для 587, '' если без шифрования
        'username' => 'mc@hs-planet.ru',
        'password' => '',                     // ПАРОЛЬ почтового ящика (НЕ от панели хостинга)
        'from'     => 'mc@hs-planet.ru',      // должен совпадать с username (иначе письма зарежут)
        'fromName' => 'Планета здоровой кожи',
    ],

    /**
     * Yandex SmartCaptcha — серверный (секретный) ключ. Используется для
     * валидации токена на https://smartcaptcha.yandexcloud.net/validate.
     *
     * Клиентский (публичный) ключ задан в src/js/config.js — его подменять
     * здесь не нужно. Если ключи разойдутся, валидация всегда будет провальной.
     */
    'captcha' => [
        'enabled'    => true,
        'server_key' => 'YOUR_SMARTCAPTCHA_SERVER_KEY', // ysc2_... — берётся в консоли Yandex SmartCaptcha, в репозиторий НЕ коммитить

        /**
         * Аварийный клапан. На боевых хостах (hs-planet.ru) отсутствие рабочей
         * капчи по умолчанию ОСТАНАВЛИВАЕТ приём заявок: посетитель видит
         * сообщение с телефоном, а контакты пишутся в drops.jsonl.
         *
         * Поставьте true, только если SmartCaptcha недоступна и заявки нужно
         * принимать прямо сейчас. В этом режиме сайт не защищён от ботов,
         * и каждое письмо о заявке будет содержать предупреждение.
         */
        'allow_missing' => false,
    ],
];
